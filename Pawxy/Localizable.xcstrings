          "stringUnit": {
            "state": "translated",
            "value": "%1$@ si risolve in %2$@ tramite dnsmasq. Fai clic per ripetere il test."
          }
        }
      }
    },
    "%@ should resolve to %@, but dnsmasq returned %@. Click to test again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ should resolve to %2$@, but dnsmasq returned %3$@. Click to test again."
